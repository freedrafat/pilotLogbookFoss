<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StripToLogbook.View"
        android:name=".LogbookApplication"
        android:windowSoftInputMode="adjustResize" >


        <activity
            android:name=".ui.HomeActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ManualActivity"
            android:exported="false" />

        <activity
            android:name=".ui.OpeningBalanceListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.OpeningBalanceEditActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LegListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LegEditActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.my.striptologbook.ACTION_IMPORT_LEG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CsvImportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.StatisticsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FlightSunActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FlightSunPreferencesActivity"
            android:parentActivityName=".ui.PreferencesActivity" />

        <activity
            android:name=".ui.BackupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ExportImportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PdfFormatActivity"
            android:parentActivityName=".ui.ExportImportActivity" />
        <activity
            android:name=".ui.PreferencesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.StatisticsVisibilityPreferencesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DefaultFieldsPreferencesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CustomListsPreferencesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LegItemsPreferencesActivity"
            android:parentActivityName=".ui.PreferencesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AirportsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AirportEditorActivity"
            android:parentActivityName=".ui.AirportsActivity" />
        <activity
            android:name=".ui.UpdatesActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>