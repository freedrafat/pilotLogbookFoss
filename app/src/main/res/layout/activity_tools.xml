<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Toolbar -->
    <include layout="@layout/view_app_toolbar" />

    <!-- Header Section -->
    <LinearLayout
        style="@style/Card.Surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tools"
            android:textSize="24sp"
            android:textStyle="bold" />


    </LinearLayout>

    <!-- Middle Section -->
    <ScrollView
        android:id="@+id/scroll_view"
        style="@style/Card.Surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_export_pdf"
                style="@style/PrimaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export PDF (ICAO/EASA Logbook)" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <Button
                android:id="@+id/btn_flight_sun"
                style="@style/PrimaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sun Events" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <Button
                android:id="@+id/btn_airports"
                style="@style/PrimaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="airports DB" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />


            <Button
                android:id="@+id/btn_backup"
                style="@style/PrimaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backup Logbook" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <Button
                android:id="@+id/btn_opening_balance"
                style="@style/SecondaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opening Balance (anterior flights)" />


        </LinearLayout>

    </ScrollView>

    <!-- Footer Section -->
    <LinearLayout
        style="@style/Card.Surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_work_directory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Work directory: Not set" />


    </LinearLayout>

</LinearLayout>