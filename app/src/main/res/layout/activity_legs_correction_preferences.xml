<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_app_toolbar" />

    <ScrollView
        android:id="@+id/scroll_legs_correction"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Takeoff / Landing -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Takeoff / Landing"
                android:textStyle="bold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_takeoff_landing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_tl_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skip" />

                <RadioButton
                    android:id="@+id/rb_tl_add"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add/Retrieve minutes" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/ll_takeoff_landing_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="16dp">

                <EditText
                    android:id="@+id/et_takeoff_offset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Takeoff (+min)"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/et_landing_offset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Landing (-min)"
                    android:inputType="number" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <!-- IFR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IFR"
                android:textStyle="bold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_ifr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_ifr_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skip" />

                <RadioButton
                    android:id="@+id/rb_ifr_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use Block Time" />

                <RadioButton
                    android:id="@+id/rb_ifr_flight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use Flight Time" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <!-- Night -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Night"
                android:textStyle="bold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_night"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_night_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skip" />

                <RadioButton
                    android:id="@+id/rb_night_real"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Real Night" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <!-- a/c Type & Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="a/c Type:"
                android:textStyle="bold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_ac_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rb_ac_type_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skip" />
                <RadioButton
                    android:id="@+id/rb_ac_type_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User Input" />
            </RadioGroup>

            <AutoCompleteTextView
                android:id="@+id/act_ac_type_value"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="a/c Type value"
                android:inputType="text"
                android:completionThreshold="2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Category:"
                android:textStyle="bold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rb_category_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skip" />
                <RadioButton
                    android:id="@+id/rb_category_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User Input" />
            </RadioGroup>

            <AutoCompleteTextView
                android:id="@+id/act_category_value"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Category value"
                android:inputType="text"
                android:completionThreshold="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <!-- Pilot Flying -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilot Flying"
                android:textStyle="bold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rg_pilot_flying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_pf_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skip" />

                <RadioButton
                    android:id="@+id/rb_pf_alternate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alternate" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btn_restore_defaults_correction"
                    style="@style/SecondaryButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Restore Defaults" />

                <Button
                    android:id="@+id/btn_save_correction"
                    style="@style/PrimaryButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Save Preferences" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>